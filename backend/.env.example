# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///instance/hiring.db
# Public URL of the React app; used to build the test links in invitation emails
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# --- Email (leave SMTP_HOST empty to log emails to the console instead of sending) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
SMTP_USE_TLS=true
MAIL_FROM=Hiring Team <you@example.com>
# Max emails per minute for bulk sends (0 = unlimited)
MAIL_RATE_PER_MINUTE=60

# --- AI (optional). Without a key, built-in question banks and heuristic scoring are used ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Code execution for coding rounds: local | judge0 | disabled ---
# "local" runs candidate code in a resource-limited subprocess. Only use it on a dedicated,
# network-isolated host/container. For production, prefer a Judge0 instance.
CODE_RUNNER=local
JUDGE0_URL=
JUDGE0_KEY=
